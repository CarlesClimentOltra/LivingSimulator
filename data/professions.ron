// Professions. Wages are per worked shift, in cents. `education`: minimum level
// (0 none, 1 primary, 2 secondary, 3 university).
[
    (id: "office_worker",   name: "Office worker",    wage_per_shift_cents: 14000, schedules: ["office_day"], education: 2),
    (id: "manager",         name: "Manager",          wage_per_shift_cents: 24000, schedules: ["office_day"], min_age: 25, education: 2),
    (id: "shop_assistant",  name: "Shop assistant",   wage_per_shift_cents: 9500,  schedules: ["retail"], min_age: 16),
    (id: "cook",            name: "Cook",             wage_per_shift_cents: 10500, schedules: ["late_shift", "weekend_late"], education: 1),
    (id: "waiter",          name: "Waiter",           wage_per_shift_cents: 9000,  schedules: ["weekend_late", "late_shift"], min_age: 16),
    (id: "barista",         name: "Barista",          wage_per_shift_cents: 8800,  schedules: ["early_shift", "retail"], min_age: 16),
    (id: "factory_worker",  name: "Factory worker",   wage_per_shift_cents: 12000, schedules: ["early_shift", "late_shift", "night_shift"], education: 1),
    (id: "warehouse_worker",name: "Warehouse worker", wage_per_shift_cents: 11000, schedules: ["early_shift", "late_shift"]),
    (id: "teacher",         name: "Teacher",          wage_per_shift_cents: 15500, schedules: ["teacher_day"], min_age: 23, education: 3),
    (id: "researcher",      name: "Researcher",       wage_per_shift_cents: 21000, schedules: ["office_day"], min_age: 24, education: 3),
    (id: "professor",       name: "Professor",        wage_per_shift_cents: 19000, schedules: ["office_day"], min_age: 28, education: 3),
    (id: "doctor",          name: "Doctor",           wage_per_shift_cents: 26000, schedules: ["early_shift", "late_shift", "night_shift"], min_age: 26, education: 3),
    (id: "nurse",           name: "Nurse",            wage_per_shift_cents: 14500, schedules: ["early_shift", "late_shift", "night_shift"], min_age: 21, education: 3),
    (id: "police_officer",  name: "Police officer",   wage_per_shift_cents: 16000, schedules: ["early_shift", "late_shift", "night_shift"], min_age: 21, education: 2),
    (id: "prison_guard",    name: "Prison guard",     wage_per_shift_cents: 14000, schedules: ["early_shift", "late_shift", "night_shift"], min_age: 21, education: 1),
    (id: "firefighter",     name: "Firefighter",      wage_per_shift_cents: 15000, schedules: ["early_shift", "late_shift", "night_shift"], min_age: 20, education: 1),
    (id: "civil_servant",   name: "Civil servant",    wage_per_shift_cents: 14500, schedules: ["office_day"], education: 2),
    (id: "farmer",          name: "Farmer",           wage_per_shift_cents: 10000, schedules: ["farm_day"]),
    (id: "gardener",        name: "Gardener",         wage_per_shift_cents: 9500,  schedules: ["early_shift"]),
    (id: "trainer",         name: "Fitness trainer",  wage_per_shift_cents: 10000, schedules: ["late_shift", "early_shift"], education: 1),
    (id: "projectionist",   name: "Cinema staff",     wage_per_shift_cents: 8800,  schedules: ["weekend_late"], min_age: 16),
    (id: "bartender",       name: "Bartender",        wage_per_shift_cents: 9200,  schedules: ["weekend_late"]),
    (id: "real_estate_agent", name: "Real estate agent", wage_per_shift_cents: 13500, schedules: ["office_day"], min_age: 20, education: 2),
    (id: "childminder",     name: "Childminder",      wage_per_shift_cents: 10500, schedules: ["daycare_day"], min_age: 20, education: 1),
