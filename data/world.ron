// The initial world. Each region is a town or city simulated independently; regions
// exchange messages once per simulated hour (see docs/ARCHITECTURE.md §5).
(
    initial_regions: [("city", "meridian"), ("village", "highland")],
    highway_tiles: 1500,
    templates: [
        (
            id: "city",
            blocks: 21,
            target_population: 10000,
            // (max distance from the centre in blocks, zone)
            rings: [(2, Downtown), (5, Mixed), (8, Residential), (99, Rural)],
            park_permille: 60,
            has_river: true,
            // Room to grow (Phase 4): up to 29x29 blocks.
            max_blocks: 29,
            required: {
                "town_hall": 1, "police_station": 2, "jail": 1, "hospital": 1, "fire_station": 1,
                "school": 3, "university": 1, "supermarket": 4, "cinema": 1, "office_tower": 2,
                "construction_firm": 1, "park": 2, "real_estate_agency": 2, "warehouse": 3, "daycare": 3, "cemetery": 1,
            },
        ),
        (
            id: "village",
            blocks: 7,
            target_population: 500,
            max_blocks: 13,
            rings: [(1, Mixed), (2, Residential), (99, Rural)],
            park_permille: 0,
            required: {"village_school": 1, "corner_shop": 2, "farm": 4, "bar": 1, "cafe": 1, "real_estate_agency": 1, "daycare": 1},
        ),
        (
            // Founded towns (Phase 6): a small settlement with room to grow.
            id: "new_town",
            blocks: 5,
            target_population: 220,
            max_blocks: 15,
            rings: [(1, Mixed), (99, Residential)],
            park_permille: 0,
            required: {"village_school": 1, "corner_shop": 1, "cafe": 1, "real_estate_agency": 1, "daycare": 1},
        ),
    ],
    // New towns (Phase 6). Every morning each town gathers "pressure" from long-term job
    // seekers, people who had to leave (no job, no home) and households waiting for a home;
    // much more when it has no room left. When a town's pressure reaches the threshold,
    // settlers found a new town down a new highway (one founding per cooldown in the whole
    // world), and some families of job seekers move there.
    expansion: (
        template: "new_town",
        max_regions: 8,
        min_world_age_days: 30,
        cooldown_days: 120,
        threshold: 400,
        points_per_emigrant: 4,
        points_per_waiting_household: 1,
        points_per_jobseeker_permille: 50,
        long_term_jobseeker_days: 30,
        settler_households: 15,
        full_land_multiplier_permille: 4000,
        full_land_free_lots: 6,
    ),
)
