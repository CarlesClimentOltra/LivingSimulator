// Text templates. Placeholders: {name} (the inhabitant), {place} (a building or region),
// {activity} (what they are doing), {amount} (money), {n} (a number), {city} (region).
(
    journal: {
        "woke_up": "Woke up at home.",
        "went_to": "Set off towards {place}.",
        "started": "Started {activity} at {place}.",
        "went_to_sleep": "Went to bed.",
        "shopped": "Bought groceries at {place} for {amount}.",
        "shelves_empty": "Found the shelves empty at {place}.",
        "got_paid": "Got paid {amount} for the day's work.",
        "left_for_region": "Left for a trip to {place}.",
        "back_from_region": "Came back home from {place}, having spent {amount}.",
        "arrived_from_region": "Arrived in town for a visit.",
        "no_food_at_home": "Wanted to eat at home but the fridge was empty.",
        "moved_in": "Moved into a home at {place}.",
        "birthday": "Turned {n} today.",
        "paid_rent": "Paid {amount} of rent for the month.",
        "missed_rent": "Could not pay the rent this month.",
        "hired": "Got a job at {place}.",
        "laid_off": "Was laid off from {place}.",
        "opened_business": "Invested savings to reopen {place}.",
        "received_rent": "Received {amount} in rent from tenants.",
        "started_dating": "Started going out with {person}.",
        "moved_in_with": "Moved in with {person}.",
        "married": "Married {person}!",
        "divorced": "Separated from {person}.",
        "baby_born": "Became a parent: {person} was born.",
        "was_born": "Was born at {place}.",
        "adopted": "Adopted {person}.",
        "was_adopted": "Was adopted by a new family.",
        "got_sick": "Fell ill and stayed home.",
        "hospitalized": "Was admitted to {place}.",
        "recovered": "Recovered from an illness.",
        "family_death": "{first}, a dear family member, passed away. The funeral was held at {place}.",
        "inherited": "Inherited {amount}.",
        "retired": "Retired after a long working life.",
        "started_school": "Started at {place}.",
        "graduated": "Graduated from {place}.",
        "left_home": "Left the family home for a place of their own.",
        "family_left": "Said goodbye to {first}, who moved away from {city}.",
        "immigrated": "Arrived in {city} to start a new life.",
        "commute_job": "Got a job at {place} in {city}, a commute away.",
        "worked_away": "Commuted to work in {city}.",
        "new_friend": "Became friends with {person}.",
        "moved_town": "Moved with the family to {city}.",
        "started_university": "Started university.",
    },
    news: {
        "daily_summary": ("Another day in {city}", "{n} trips were made around town yesterday."),
        "busiest_place": ("{place} was the place to be", "{n} people visited {place} yesterday."),
        "shelves_empty": ("Empty shelves at {place}", "Customers found nothing to buy at {place} {n} times yesterday."),
        "visitors": ("Visitors from {place}", "{n} people came from {place} to spend the day in town."),
        "food_delivery": ("Fresh produce arrives", "{n} meals worth of food arrived from the farms of {place}."),
        "city_founded": ("Welcome to {city}", "The town of {city} is home to {n} people."),
        "price_up": ("Groceries get pricier", "The average price of a meal at {city}'s shops rose to {amount}."),
        "price_down": ("Cheaper groceries", "The average price of a meal at {city}'s shops fell to {amount}."),
        "bankruptcy": ("{place} closes its doors", "{place} went bankrupt and let go of {n} employees."),
        "reopened": ("{place} reopens", "{place} is open again under a new owner."),
        "unemployment": ("Jobs report", "Unemployment in {city} stands at {n}‰ of the working population."),
        "budget": ("Town budget", "The town hall closed the month with {amount} in the treasury."),
        "tax_change": ("Income tax changes", "The town hall set income tax at {n}‰."),
        "food_imports": ("Food imported", "Warehouses had to import {n} meals from outside the region yesterday."),
        "births": ("Welcome, little ones", "{n} babies were born in {city} yesterday."),
        "obituary": ("Obituary", "{place} passed away at the age of {n}. Rest in peace."),
        "wedding": ("Wedding bells", "{place} got married yesterday. Congratulations!"),
        "centenarian": ("A hundred candles", "{place} celebrated their 100th birthday."),
        "census": ("Monthly census", "{city} is now home to {n} people."),
        "migration": ("Comings and goings", "{n} people moved to {city} last week, and {place} left."),
        "commuters": ("Commuters", "{n} people from {place} now work in {city}."),
    },
)
