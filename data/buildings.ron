// Buildings. Blocks are 12x12 tiles, split into lots: Small (4x6, six per block),
// Medium (6x6, four per block) or Large (12x12, whole block).
// `zones` gives the weight of this building when the generator fills a lot of that zone.
// `tags` connect buildings with activities (activities.ron) and services.
// Colours are flat "#rrggbb" for the low-poly renderer.
[
    // ---------------------------------------------------------------- housing
    (id: "house", name: "House", lot: Small, size: (3, 4), floors: 1, dwellings: 1,
     zones: {Residential: 100, Rural: 100, Mixed: 8},
     color: "#f2d7b6", roof_color: "#d9644a", roof: Gabled),
    (id: "terraced_houses", name: "Terraced houses", lot: Small, size: (4, 4), floors: 2, dwellings: 3,
     zones: {Residential: 45, Mixed: 25},
     color: "#e9c4a0", roof_color: "#a8503c", roof: Gabled),
    (id: "apartments", name: "Apartment block", lot: Medium, size: (6, 5), floors: 4, dwellings: 14,
     zones: {Mixed: 100, Downtown: 25, Residential: 6},
     color: "#e8e0d0", roof_color: "#9aa0a6"),
    (id: "apartment_tower", name: "Apartment tower", lot: Medium, size: (5, 5), floors: 10, dwellings: 40,
     zones: {Downtown: 70, Mixed: 10},
     color: "#cfd8dc", roof_color: "#78909c"),

    // ---------------------------------------------------------------- commerce
    (id: "corner_shop", name: "Corner shop", lot: Small, size: (3, 3), floors: 1,
     jobs: {"shop_assistant": 3}, tags: ["grocery", "shop"], open: "08:00-21:00", open_days: "Mon-Sat",
     stock: 500, zones: {Residential: 9, Mixed: 10, Rural: 3},
     capacity: 15, name_patterns: ["{family} Corner Shop", "{place} Groceries", "{given}'s Shop"],
     color: "#ffcc80", roof_color: "#4caf50"),
    (id: "supermarket", name: "Supermarket", lot: Medium, size: (6, 5), floors: 1,
     jobs: {"shop_assistant": 22, "manager": 2, "warehouse_worker": 4}, tags: ["grocery", "shop"],
     open: "08:00-22:00", open_days: "Mon-Sat", stock: 7000, zones: {Mixed: 9, Downtown: 4, Residential: 1},
     capacity: 120, name_patterns: ["{place} Market", "{family} Supermarket", "Fresh {place}"],
     color: "#fff3e0", roof_color: "#e53935"),
    (id: "cafe", name: "Café", lot: Small, size: (3, 3), floors: 1,
     jobs: {"barista": 4}, tags: ["cafe"], open: "07:00-20:00", open_days: "daily",
     zones: {Downtown: 12, Mixed: 12, Residential: 4},
     capacity: 30, name_patterns: ["Café {place}", "{given}'s Coffee", "The {family} Bean"],
     color: "#bcaaa4", roof_color: "#6d4c41"),
    (id: "restaurant", name: "Restaurant", lot: Small, size: (4, 4), floors: 1,
     jobs: {"cook": 4, "waiter": 6}, tags: ["restaurant"], open: "12:00-23:30", open_days: "daily",
     zones: {Downtown: 12, Mixed: 10, Residential: 3},
     capacity: 45, name_patterns: ["{family}'s Kitchen", "Casa {place}", "The {place} Table"],
     color: "#ef9a9a", roof_color: "#c62828"),
    (id: "bar", name: "Bar", lot: Small, size: (3, 4), floors: 1,
     jobs: {"bartender": 5}, tags: ["bar"], open: "17:00-02:00", open_days: "daily",
     zones: {Downtown: 8, Mixed: 8, Residential: 2, Rural: 1},
     capacity: 60, name_patterns: ["The {family} Arms", "Bar {place}", "{given}'s Tavern"],
     color: "#9575cd", roof_color: "#4527a0"),
    (id: "cinema", name: "Cinema", lot: Medium, size: (6, 6), floors: 2,
     jobs: {"projectionist": 8, "manager": 1}, tags: ["cinema"], open: "16:00-23:59", open_days: "daily",
     zones: {Downtown: 3},
     capacity: 320, name_patterns: ["Cinema {place}", "{place} Pictures"],
     color: "#263238", roof_color: "#ffca28"),
    (id: "gym", name: "Gym", lot: Medium, size: (5, 5), floors: 2,
     jobs: {"trainer": 6}, tags: ["gym"], open: "07:00-22:00", open_days: "daily",
     zones: {Mixed: 3, Downtown: 3},
     capacity: 50, name_patterns: ["{place} Fitness", "{family} Gym"],
     color: "#80deea", roof_color: "#00838f"),

    // ---------------------------------------------------------------- work
    (id: "office", name: "Office building", lot: Medium, size: (6, 6), floors: 6,
     jobs: {"office_worker": 70, "manager": 6}, tags: ["office"],
     zones: {Downtown: 40, Mixed: 10},
     name_patterns: ["{family} & Partners", "{place} Consulting", "{family} Insurance"],
     color: "#90caf9", roof_color: "#546e7a"),
    (id: "office_tower", name: "Office tower", lot: Large, size: (10, 10), floors: 16,
     jobs: {"office_worker": 380, "manager": 30}, tags: ["office"],
     zones: {Downtown: 6},
     name_patterns: ["{place} Tower", "{family} Group HQ"],
     color: "#64b5f6", roof_color: "#37474f"),
    (id: "factory", name: "Factory", lot: Large, size: (11, 9), floors: 2,
     jobs: {"factory_worker": 140, "manager": 5}, tags: ["factory"],
     zones: {Industrial: 60},
     name_patterns: ["{family} Industries", "{place} Works", "{family} Manufacturing"],
     color: "#b0bec5", roof_color: "#607d8b"),
    (id: "warehouse", name: "Warehouse", lot: Medium, size: (6, 6), floors: 1,
     jobs: {"warehouse_worker": 25}, tags: ["warehouse"],
     zones: {Industrial: 40},
     name_patterns: ["{place} Logistics", "{family} Storage"],
     color: "#bcaaa4", roof_color: "#795548"),
    (id: "farm", name: "Farm", lot: Large, size: (4, 4), floors: 1,
     jobs: {"farmer": 6}, tags: ["farm"],
     zones: {Rural: 22},
     name_patterns: ["{family} Farm", "{place} Fields"],
     color: "#fff8e1", roof_color: "#8d6e63", roof: Gabled),
    (id: "allotments", name: "Allotments", lot: Medium, size: (6, 6), floors: 1,
     jobs: {"gardener": 3}, tags: ["farm", "park"], open: "07:00-21:00",
     zones: {Residential: 2, Rural: 4},
     capacity: 40, name_patterns: ["{place} Allotments"],
     color: "#aed581", roof_color: "#689f38", roof: None),

    // ---------------------------------------------------------------- public services
    (id: "town_hall", name: "Town hall", lot: Medium, size: (6, 6), floors: 3,
     jobs: {"civil_servant": 50}, tags: ["town_hall"],
     name_patterns: ["{place} Town Hall"],
     color: "#fff59d", roof_color: "#8d6e63", roof: Gabled),
    (id: "school", name: "School", lot: Large, size: (10, 7), floors: 2,
     jobs: {"teacher": 40}, tags: ["school"], students: 700,
     name_patterns: ["{place} School", "{family} Academy"],
     color: "#ffe082", roof_color: "#ef6c00"),
    (id: "village_school", name: "Village school", lot: Medium, size: (6, 5), floors: 1,
     jobs: {"teacher": 6}, tags: ["school"], students: 150,
     name_patterns: ["{place} Primary"],
     color: "#ffe082", roof_color: "#ef6c00", roof: Gabled),
    (id: "university", name: "University", lot: Large, size: (11, 10), floors: 4,
     jobs: {"professor": 90, "civil_servant": 20}, tags: ["university"], students: 1200,
     name_patterns: ["University of {place}"],
     color: "#d7ccc8", roof_color: "#5d4037"),
    (id: "hospital", name: "Hospital", lot: Large, size: (10, 9), floors: 5,
     jobs: {"doctor": 45, "nurse": 120, "civil_servant": 10}, tags: ["hospital"],
     name_patterns: ["{place} General Hospital", "St. {given} Hospital"],
     color: "#fafafa", roof_color: "#e53935"),
    (id: "police_station", name: "Police station", lot: Medium, size: (6, 5), floors: 2,
     jobs: {"police_officer": 45, "civil_servant": 5}, tags: ["police"],
     name_patterns: ["{place} Police Station"],
     color: "#5c6bc0", roof_color: "#283593"),
    (id: "jail", name: "Jail", lot: Large, size: (10, 10), floors: 2,
     jobs: {"prison_guard": 30}, tags: ["jail"],
     name_patterns: ["{place} Correctional Facility"],
     color: "#9e9e9e", roof_color: "#424242"),
    (id: "fire_station", name: "Fire station", lot: Medium, size: (6, 5), floors: 2,
     jobs: {"firefighter": 25}, tags: ["fire_station"],
     name_patterns: ["{place} Fire Station"],
     color: "#e53935", roof_color: "#b71c1c"),
    (id: "park", name: "Park", lot: Large, size: (12, 12), floors: 1,
     jobs: {"gardener": 3}, tags: ["park"], zones: {Park: 100}, open: "06:30-22:30",
     capacity: 400, name_patterns: ["{place} Park", "{family} Gardens"],
     color: "#7cb342", roof_color: "#558b2f", roof: None),
    (id: "plaza", name: "Plaza", lot: Medium, size: (6, 6), floors: 1,
     tags: ["park"], zones: {Downtown: 3, Mixed: 2}, open: "06:30-23:30",
     capacity: 150, name_patterns: ["{place} Square"],
     color: "#d7ccc8", roof_color: "#a1887f", roof: None),
    (id: "construction_firm", name: "Construction company", lot: Medium, size: (6, 4), floors: 1,
     jobs: {"builder": 30, "manager": 2}, tags: ["construction"],
     name_patterns: ["{family} Builders", "{place} Construction"],
     color: "#ffb74d", roof_color: "#e65100"),

    // ---------------------------------------------------------------- infrastructure
    // Where a highway leaves the region. Visitors from other towns appear and leave here.
    // Never placed by zoning (no `zones`).
    (id: "highway_exit", name: "Highway exit", lot: Small, size: (2, 2), floors: 1,
     tags: ["gateway"], name_patterns: ["{place} Interchange"],
     color: "#78909c", roof_color: "#455a64"),
]
