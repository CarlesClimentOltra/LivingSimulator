// Activities inhabitants can choose. `effects` are per simulated hour and are added to the
// need's base decay (see needs.ron). `place` is Home, Workplace, OtherRegion or Tag("…"),
// where the tag refers to building tags in buildings.ron.
[
    (id: "sleep", name: "Sleep", kind: Sleep, place: Home,
     effects: {"energy": 1820, "hunger": 420, "hygiene": 150, "fun": 380, "social": 280},
     minutes: (360, 600), doing: "sleeping"),

    (id: "work", name: "Work", kind: Work, place: Workplace,
     effects: {"hunger": 300, "energy": -80, "fun": -100, "social": 380},
     minutes: (60, 720), doing: "working"),

    (id: "school", name: "School", kind: School, place: Workplace,
     effects: {"hunger": 300, "fun": 200, "social": 600},
     minutes: (60, 480), doing: "at class"),

    (id: "breakfast", name: "Eat at home", kind: EatHome, place: Home,
     effects: {"hunger": 15000, "social": 300},
     minutes: (20, 40), doing: "eating"),

    (id: "shower", name: "Shower", kind: Hygiene, place: Home,
     effects: {"hygiene": 28000, "fun": 300},
     minutes: (15, 25), doing: "showering"),

    (id: "watch_tv", name: "Watch TV", kind: Relax, place: Home,
     effects: {"fun": 1600, "energy": 200},
     minutes: (45, 150), bias: 150, doing: "watching TV"),

    (id: "read_book", name: "Read a book", kind: Relax, place: Home,
     effects: {"fun": 1100, "energy": 250},
     minutes: (30, 90), ages: (8, 255), doing: "reading"),

